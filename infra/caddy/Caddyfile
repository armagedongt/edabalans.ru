{
	admin off
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /telegram/webhook {
		reverse_proxy telegram-bot:8001
	}

	handle /telegram/ready {
		uri replace /telegram/ready /ready
		reverse_proxy telegram-bot:8001
	}

	handle /r/* {
		reverse_proxy telegram-bot:8001
	}

	handle /bot* {
		reverse_proxy telegram-bot:8001
	}

	handle {
		reverse_proxy backend:8000
	}

	log {
		output stdout
		format json
	}
}

{$DATA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		-Server
	}

	reverse_proxy nocodb:8080

	log {
		output stdout
		format json
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self' https://xn-----jlceacr3bggd8ajed5a6kl.xn--p1ai"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /docs {
		redir https://go.похудение-это-есть.рф/legal/privacy 302
	}

	handle {
		reverse_proxy backend:8000
	}

	log {
		output stdout
		format json
	}
}

{$GO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@legal_index path /legal /legal/
	handle @legal_index {
		rewrite * /legal/index.html
		reverse_proxy backend:8000
	}

	@legal_friendly path_regexp legal_friendly ^/legal/(privacy|consent|disclaimer|offer)/?$
	handle @legal_friendly {
		rewrite * /legal/{re.legal_friendly.1}.html
		reverse_proxy backend:8000
	}

	handle /legal/* {
		reverse_proxy backend:8000
	}

	@robokassa_test_pages path /robokassa-test /robokassa-test/start
	handle @robokassa_test_pages {
		reverse_proxy backend:8000
	}

	handle /integrations/robokassa/result2 {
		reverse_proxy backend:8000
	}

	@robokassa_test_returns path /payments/robokassa/success /payments/robokassa/fail
	handle @robokassa_test_returns {
		reverse_proxy backend:8000
	}

	@robokassa_test_status {
		method GET
		path_regexp robokassa_test_status ^/api/payments/robokassa/[0-9]+/status$
	}
	handle @robokassa_test_status {
		reverse_proxy backend:8000
	}

	@account_app path /lk /lk/ /embed.js /site-footer.js /site-header.js /apps/* /assets/* /content/* /api/*
	handle @account_app {
		reverse_proxy backend:8000
	}

	@intensive_entry path_regexp intensive_entry ^/i/([A-Za-z0-9_-]+)$
	handle @intensive_entry {
		redir https://app.edabalans.ru/intensive/start?i={re.intensive_entry.1} 307
	}

	@short path_regexp short ^/([^/]+)$
	handle @short {
		rewrite * /go/{re.short.1}
		reverse_proxy telegram-bot:8001
	}

	respond 404
}

{$BLOG_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@blog_home path /
	handle @blog_home {
		rewrite * /blog
		reverse_proxy backend:8000
	}

	handle /blog/fonts/* {
		reverse_proxy backend:8000
	}

	handle /blog/assets/* {
		reverse_proxy backend:8000
	}

	handle /blog/media/* {
		reverse_proxy backend:8000
	}

	@blog_article path_regexp blog_article ^/articles/([a-z0-9]+(?:-[a-z0-9]+)*)/?$
	handle @blog_article {
		rewrite * /blog/articles/{re.blog_article.1}
		reverse_proxy backend:8000
	}

	@blog_favicon_test path_regexp blog_favicon_test ^/favicon-tests/(black|blue|face)/?$
	handle @blog_favicon_test {
		rewrite * /blog/favicon-tests/{re.blog_favicon_test.1}
		reverse_proxy backend:8000
	}

	handle /sitemap.xml {
		rewrite * /blog/sitemap.xml
		reverse_proxy backend:8000
	}

	handle /robots.txt {
		rewrite * /blog/robots.txt
		reverse_proxy backend:8000
	}

	respond 404

	log {
		output stdout
		format json
	}
}
