{
	admin off
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /telegram/webhook {
		reverse_proxy telegram-bot:8001
	}

	handle /r/* {
		reverse_proxy telegram-bot:8001
	}

	handle /bot* {
		reverse_proxy telegram-bot:8001
	}

	handle {
		reverse_proxy backend:8000
	}

	log {
		output stdout
		format json
	}
}

{$DATA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		-Server
	}

	reverse_proxy nocodb:8080

	log {
		output stdout
		format json
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy backend:8000

	log {
		output stdout
		format json
	}
}

{$GO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@legal_index path /legal /legal/
	handle @legal_index {
		rewrite * /legal/index.html
		reverse_proxy backend:8000
	}

	@legal_friendly path_regexp legal_friendly ^/legal/(privacy|disclaimer)/?$
	handle @legal_friendly {
		rewrite * /legal/{re.legal_friendly.1}.html
		reverse_proxy backend:8000
	}

	handle /legal/*.html {
		reverse_proxy backend:8000
	}

	@short path_regexp short ^/([^/]+)$
	handle @short {
		rewrite * /go/{re.short.1}
		reverse_proxy telegram-bot:8001
	}

	respond 404
}
