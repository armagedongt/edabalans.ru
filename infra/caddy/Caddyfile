{
	admin off
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /telegram/webhook {
		reverse_proxy telegram-bot:8001
	}

	handle /r/* {
		reverse_proxy telegram-bot:8001
	}

	handle /bot* {
		reverse_proxy telegram-bot:8001
	}

	handle {
		reverse_proxy backend:8000
	}

	log {
		output stdout
		format json
	}
}

{$DATA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy nocodb:8080

	log {
		output stdout
		format json
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy backend:8000

	log {
		output stdout
		format json
	}
}
