{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edabalans-watchdog",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCHDOG",
        "class_name": "WatchdogCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WatchdogCoordinator"]
    }
  ],
  "vars": {
    "PLATFORM_READY_URL": "https://edabalans.ru/ready",
    "TELEGRAM_READY_URL": "https://edabalans.ru/api/health/telegram",
    "FAILURES_BEFORE_INCIDENT": "3",
    "ADS_PAUSE_AFTER_SECONDS": "60",
    "RU_REBOOT_AFTER_SECONDS": "240",
    "RECOVERY_STABLE_SECONDS": "300",
    "RECOVERY_SUCCESSES_BEFORE_RESUME": "10",
    "ACTION_RETRY_SECONDS": "120",
    "MAX_ACTION_ATTEMPTS": "3",
    "CHECK_TIMEOUT_MS": "10000",
    "MARKETING_REPORT_URL": "https://edabalans.ru/api/internal/marketing/daily-report",
    "REPORT_STATE_CUTOVER_DATE": "2026-09-08",
    "SEND_REPORT_AI_DEMO_ONCE": "true",
    "SEND_RICH_REPORT_PREVIEW_ONCE": "true"
  }
}
