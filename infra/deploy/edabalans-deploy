#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/edabalans"
readonly LOCK_FILE="/var/lock/edabalans-deploy.lock"

if (($# != 1)) || [[ ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
    echo "A single full Git commit SHA is required" >&2
    exit 2
fi

readonly TARGET_SHA="$1"

exec 9>"${LOCK_FILE}"
if ! flock --nonblock 9; then
    echo "Another production deployment is already running" >&2
    exit 3
fi

cd "${APP_DIR}"
# GitHub's public smart-HTTP endpoint intermittently breaks the installed Git
# client's HTTP/2 stream on this host. HTTP/1.1 is deterministic and needs no
# credentials for this public repository.
git -c http.version=HTTP/1.1 fetch --quiet origin main

readonly REMOTE_SHA="$(git rev-parse origin/main)"
if [[ "${TARGET_SHA}" != "${REMOTE_SHA}" ]]; then
    echo "Requested commit is not the current origin/main" >&2
    exit 4
fi

readonly PREVIOUS_SHA="$(git rev-parse HEAD)"
deployment_started=false
deployment_succeeded=false
read -r migration_deploy startup_data_deploy backend_changed telegram_changed caddy_changed compose_changed < <(
    git show "${TARGET_SHA}:infra/deploy/classify-deploy-impact" \
        | bash -s -- "${APP_DIR}" "${PREVIOUS_SHA}" "${TARGET_SHA}"
)

build_changed_services() {
    local -a build_services=()

    if [[ "${backend_changed}" == "true" ]]; then
        build_services+=(backend)
    fi
    if [[ "${telegram_changed}" == "true" ]]; then
        build_services+=(telegram-bot)
    fi

    if ((${#build_services[@]})); then
        docker compose build "${build_services[@]}"
    else
        echo "No application image changed; skipping Docker build"
    fi
}

start_changed_services() {
    local -a runtime_services=()

    if [[ "${compose_changed}" == "true" ]]; then
        docker compose up -d --remove-orphans --wait --wait-timeout 180
    else
        if [[ "${backend_changed}" == "true" ]]; then
            runtime_services+=(backend)
        fi
        if [[ "${telegram_changed}" == "true" ]]; then
            runtime_services+=(telegram-bot)
        fi

        if ((${#runtime_services[@]})); then
            docker compose up -d --no-deps --wait --wait-timeout 180 "${runtime_services[@]}"
        else
            echo "No application service changed; skipping application restart"
        fi

    fi

    # Bind-mounted Caddy source does not trigger Compose recreation by itself.
    if [[ "${caddy_changed}" == "true" ]]; then
        docker compose up -d --no-deps --force-recreate --wait --wait-timeout 180 caddy
    fi
}

if [[ "${migration_deploy}" == "true" && "${ALLOW_DATABASE_MIGRATIONS:-0}" != "1" ]]; then
    echo "Deployment includes database migrations and requires ALLOW_DATABASE_MIGRATIONS=1 after manual verification" >&2
    exit 5
fi

rollback() {
    local exit_code="$?"
    trap - EXIT

    if [[ "${deployment_started}" == "true" && "${deployment_succeeded}" != "true" ]]; then
        echo "Deployment failed; restoring ${PREVIOUS_SHA}"
        if [[ "${migration_deploy}" == "true" ]]; then
            echo "Migration deployment failed after it may have changed the database; automatic code rollback is unsafe" >&2
            echo "Keeping ${TARGET_SHA} checked out for manual recovery with the matching migration files" >&2
        else
            git checkout --quiet --force "${PREVIOUS_SHA}"
            if ! python3 tools/module_inventory.py --tracked-only; then
                echo "Inventory refresh failed during rollback; restoring the previous containers with its checked-in map" >&2
                git checkout --quiet --force "${PREVIOUS_SHA}"
            fi
            build_changed_services
            start_changed_services
        fi
    fi

    exit "${exit_code}"
}
trap rollback EXIT

if [[ "${migration_deploy}" == "true" || "${startup_data_deploy}" == "true" ]]; then
    "${APP_DIR}/infra/scripts/backup-postgres.sh"
fi

deployment_started=true
git checkout --quiet --force "${TARGET_SHA}"
# Generated module views are rebuilt from this exact checked-out commit. They are
# intentionally not a separate release gate or a reason for a follow-up commit.
python3 tools/module_inventory.py --tracked-only
docker compose config --quiet
# Routine releases reuse the server's cached base images. Pulling Python on every
# code-only release makes production availability depend on Docker Hub's anonymous
# rate limit; explicit image refreshes remain an operational action.
build_changed_services
start_changed_services

curl --fail --silent --show-error --max-time 15 \
    https://api.edabalans.ru/health >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://api.edabalans.ru/ready >/dev/null
curl --fail --silent --show-error --max-time 20 \
    https://data.edabalans.ru/api/v1/health >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://app.edabalans.ru/apps/masterclass-course.html >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://app.edabalans.ru/preview/homepage-mobile?theme=blue-rhythm >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://app.edabalans.ru/api/public-site/content/approach >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://app.edabalans.ru/api/pricing/site/preview >/dev/null
curl --fail --silent --show-error --retry 5 --retry-all-errors --retry-delay 3 --max-time 20 \
    https://blog.похудение-это-есть.рф/ >/dev/null
curl --fail --silent --show-error --max-time 20 \
    https://blog.похудение-это-есть.рф/articles/skolko-vremeni-nuzhno-na-pohudenie >/dev/null
curl --fail --silent --show-error --max-time 20 \
    https://blog.похудение-это-есть.рф/blog/media/13277231/01.png >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://blog.похудение-это-есть.рф/sitemap.xml >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://blog.похудение-это-есть.рф/robots.txt >/dev/null
for favicon_page in black blue face; do
    curl --fail --silent --show-error --max-time 15 \
        "https://blog.похудение-это-есть.рф/favicon-tests/${favicon_page}" >/dev/null
done
for favicon_asset in favicon-test-black.svg favicon-test-blue.svg favicon-test-face.png; do
    curl --fail --silent --show-error --max-time 15 \
        "https://blog.похудение-это-есть.рф/blog/assets/${favicon_asset}" >/dev/null
done

if [[ "${caddy_changed}" == "true" ]]; then
    app_headers="$(curl --fail --silent --show-error --max-time 15 \
        --dump-header - --output /dev/null \
        https://app.edabalans.ru/apps/masterclass-course.html | tr -d '\r')"
    if ! grep -Fqi \
        "content-security-policy: frame-ancestors 'self' https://xn-----jlceacr3bggd8ajed5a6kl.xn--p1ai" \
        <<<"${app_headers}"; then
        echo "Caddy did not apply the required Tilda embedding policy" >&2
        exit 1
    fi
    if grep -Fqi "x-frame-options:" <<<"${app_headers}"; then
        echo "Caddy still returns X-Frame-Options for the embeddable app" >&2
        exit 1
    fi
fi

# The timer launches installed control-plane copies. Refresh them only after the
# target revision is healthy so the next deployment uses the reviewed scripts.
install -m 0755 "${APP_DIR}/infra/deploy/edabalans-deploy" \
    /usr/local/sbin/edabalans-deploy
install -m 0755 "${APP_DIR}/infra/deploy/edabalans-deploy-poll" \
    /usr/local/sbin/edabalans-deploy-poll

deployment_succeeded=true
echo "Production deployed successfully: ${TARGET_SHA}"
