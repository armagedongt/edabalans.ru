#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/edabalans"
readonly LOCK_FILE="/var/lock/edabalans-deploy.lock"

if (($# != 1)) || [[ ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
    echo "A single full Git commit SHA is required" >&2
    exit 2
fi

readonly TARGET_SHA="$1"

exec 9>"${LOCK_FILE}"
if ! flock --nonblock 9; then
    echo "Another production deployment is already running" >&2
    exit 3
fi

cd "${APP_DIR}"
git fetch --quiet origin main

readonly REMOTE_SHA="$(git rev-parse origin/main)"
if [[ "${TARGET_SHA}" != "${REMOTE_SHA}" ]]; then
    echo "Requested commit is not the current origin/main" >&2
    exit 4
fi

readonly PREVIOUS_SHA="$(git rev-parse HEAD)"
deployment_started=false
deployment_succeeded=false
read -r migration_deploy startup_data_deploy < <(
    git show "${TARGET_SHA}:infra/deploy/classify-deploy-impact" \
        | bash -s -- "${APP_DIR}" "${PREVIOUS_SHA}" "${TARGET_SHA}"
)

if [[ "${migration_deploy}" == "true" && "${ALLOW_DATABASE_MIGRATIONS:-0}" != "1" ]]; then
    echo "Deployment includes database migrations and requires ALLOW_DATABASE_MIGRATIONS=1 after manual verification" >&2
    exit 5
fi

rollback() {
    local exit_code="$?"
    trap - EXIT

    if [[ "${deployment_started}" == "true" && "${deployment_succeeded}" != "true" ]]; then
        echo "Deployment failed; restoring ${PREVIOUS_SHA}"
        if [[ "${migration_deploy}" == "true" ]]; then
            echo "Migration deployment failed after it may have changed the database; automatic code rollback is unsafe" >&2
            echo "Keeping ${TARGET_SHA} checked out for manual recovery with the matching migration files" >&2
        else
            git checkout --quiet --force "${PREVIOUS_SHA}"
            if ! python3 tools/module_inventory.py --tracked-only; then
                echo "Inventory refresh failed during rollback; restoring the previous containers with its checked-in map" >&2
                git checkout --quiet --force "${PREVIOUS_SHA}"
            fi
            docker compose build
            docker compose up -d --remove-orphans --wait --wait-timeout 180
        fi
    fi

    exit "${exit_code}"
}
trap rollback EXIT

if [[ "${migration_deploy}" == "true" || "${startup_data_deploy}" == "true" ]]; then
    "${APP_DIR}/infra/scripts/backup-postgres.sh"
fi

deployment_started=true
git checkout --quiet --force "${TARGET_SHA}"
# Generated module views are rebuilt from this exact checked-out commit. They are
# intentionally not a separate release gate or a reason for a follow-up commit.
python3 tools/module_inventory.py --tracked-only
docker compose config --quiet
docker compose build --pull
docker compose up -d --remove-orphans --wait --wait-timeout 180

curl --fail --silent --show-error --max-time 15 \
    https://api.edabalans.ru/health >/dev/null
curl --fail --silent --show-error --max-time 15 \
    https://api.edabalans.ru/ready >/dev/null
curl --fail --silent --show-error --max-time 20 \
    https://data.edabalans.ru/api/v1/health >/dev/null

# The timer launches installed control-plane copies. Refresh them only after the
# target revision is healthy so the next deployment uses the reviewed scripts.
install -m 0755 "${APP_DIR}/infra/deploy/edabalans-deploy" \
    /usr/local/sbin/edabalans-deploy
install -m 0755 "${APP_DIR}/infra/deploy/edabalans-deploy-poll" \
    /usr/local/sbin/edabalans-deploy-poll

deployment_succeeded=true
echo "Production deployed successfully: ${TARGET_SHA}"
