#!/usr/bin/env bash
set -Eeuo pipefail

if (($# != 3)); then
    echo "Usage: classify-deploy-impact REPOSITORY PREVIOUS_SHA TARGET_SHA" >&2
    exit 2
fi

readonly REPOSITORY="$1"
readonly PREVIOUS_SHA="$2"
readonly TARGET_SHA="$3"

migration_deploy=false
startup_data_deploy=false
backend_changed=false
telegram_changed=false
caddy_changed=false
compose_changed=false
changed_files="$(git -C "${REPOSITORY}" diff --name-only "${PREVIOUS_SHA}" "${TARGET_SHA}")"

if grep -Eq '^(backend/|docs/|PROJECT_CONTEXT\.md$|ARCHITECTURE\.md$|\.dockerignore$|content/masterclass/imported-draft/extracted-2026-08-23\.json$|content/masterclass/course/course\.json$|content/masterclass/source-current/|content/masterclass/components/|content/calories/course/course\.json$)' <<<"${changed_files}"; then
    backend_changed=true
fi

if grep -q '^telegram-bot/' <<<"${changed_files}"; then
    telegram_changed=true
fi

if grep -q '^infra/caddy/' <<<"${changed_files}"; then
    caddy_changed=true
fi

if grep -q '^compose\.yaml$' <<<"${changed_files}"; then
    compose_changed=true
    backend_changed=true
    telegram_changed=true
    caddy_changed=true
fi

if grep -q '^backend/migrations/versions/' <<<"${changed_files}"; then
    migration_deploy=true
fi

if grep -Eq '^telegram-bot/service/app/seed\.py$' <<<"${changed_files}"; then
    startup_data_deploy=true
elif grep -Eq '^telegram-bot/service/app/main\.py$' <<<"${changed_files}"; then
    previous_startup_seed_call="$(git -C "${REPOSITORY}" show "${PREVIOUS_SHA}:telegram-bot/service/app/main.py" \
        | sed -n '/^        seed_defaults(/,/^        )/p')"
    target_startup_seed_call="$(git -C "${REPOSITORY}" show "${TARGET_SHA}:telegram-bot/service/app/main.py" \
        | sed -n '/^        seed_defaults(/,/^        )/p')"
    if [[ "${previous_startup_seed_call}" != "${target_startup_seed_call}" ]]; then
        startup_data_deploy=true
    fi
fi

printf '%s %s %s %s %s %s\n' \
    "${migration_deploy}" \
    "${startup_data_deploy}" \
    "${backend_changed}" \
    "${telegram_changed}" \
    "${caddy_changed}" \
    "${compose_changed}"
