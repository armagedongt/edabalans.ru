# Public settings
API_DOMAIN=api.edabalans.ru
DATA_DOMAIN=data.edabalans.ru
APP_DOMAIN=app.edabalans.ru
GO_DOMAIN=go.похудение-это-есть.рф
BLOG_DOMAIN=blog.похудение-это-есть.рф
ALLOWED_ORIGINS=https://похудение-это-есть.рф
ACME_EMAIL=replace-with-owner-email@example.com

# PostgreSQL settings. Generate unique production values on the server.
POSTGRES_DB=edabalans
POSTGRES_USER=edabalans
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://edabalans:replace-with-a-long-random-password@postgres:5432/edabalans

# Protected owner-facing CRM. Generate unique production values on the server.
ADMIN_USERNAME=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Independent HMAC key for client email challenges and 30-day application sessions.
APP_AUTH_SECRET=replace-with-a-different-long-random-secret

# Tilda sends this value in the X-Tilda-Webhook-Token header.
TILDA_WEBHOOK_TOKEN=replace-with-a-long-random-secret

# One-time email codes for client applications. For Yandex Mail use smtp.yandex.ru:465
# with an application password, never the primary mailbox password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=owner@example.com
SMTP_PASSWORD=replace-with-mail-application-password
SMTP_FROM_EMAIL=owner@example.com
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# Test Telegram bot. Keep real values only in the server .env.
TELEGRAM_TEST_BOT_USERNAME=TetrisgfgfgfBot
TELEGRAM_TEST_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_CHANNEL_ID=@Fitness_Talks
TELEGRAM_MAINTENANCE_MODE=false
TELEGRAM_MAINTENANCE_ALLOWED_USER_IDS=
POSTPURCHASE_DISPATCH_ENABLED=false
POSTPURCHASE_TEST_ONLY=true
MASTERCLASS_OFFERS_URL=https://похудение-это-есть.рф/lk
MASTERCLASS_COURSE_URL=https://похудение-это-есть.рф/lk
MASTERCLASS_ACCOUNT_URL=https://похудение-это-есть.рф/lk
PERSONAL_ACCESS_PAGE_URL=https://похудение-это-есть.рф/personal-access
# Keep false until the redesigned sales page is published and a pricing version is approved.
PRICING_CATALOG_ENABLED=false

# Private bearer token for Codex access to the knowledge-library MCP endpoint.
# Generate a separate random value; never reuse ADMIN_PASSWORD or commit the real token.
KNOWLEDGE_MCP_TOKEN=replace-with-a-different-long-random-secret

# Marketing analytics. The Direct token stays only in the server environment.
YANDEX_METRIKA_COUNTER_ID=97331502
YANDEX_OAUTH_TOKEN=
YANDEX_METRIKA_OFFLINE_ENABLED=false
YANDEX_METRIKA_OFFLINE_INTERVAL_SECONDS=300
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_CLIENT_LOGIN=
MARKETING_DAY_ONE_EVENTS_ENABLED=false
MARKETING_SITE_HOME_EVENTS_ENABLED=false
MARKETING_LATER_DAY_EVENTS_ENABLED=false

# NocoDB administration. Keep all real values only in the server .env.
NOCODB_ADMIN_EMAIL=replace-with-owner-email@example.com
NOCODB_ADMIN_PASSWORD=replace-with-a-long-random-password
NOCODB_JWT_SECRET=replace-with-a-long-random-secret
NOCODB_CONNECTION_ENCRYPT_KEY=replace-with-a-long-random-secret
