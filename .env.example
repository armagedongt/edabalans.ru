# Public settings
API_DOMAIN=api.edabalans.ru
DATA_DOMAIN=data.edabalans.ru
APP_DOMAIN=app.edabalans.ru
GO_DOMAIN=go.похудение-это-есть.рф
ALLOWED_ORIGINS=https://похудение-это-есть.рф
ACME_EMAIL=replace-with-owner-email@example.com

# PostgreSQL settings. Generate unique production values on the server.
POSTGRES_DB=edabalans
POSTGRES_USER=edabalans
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://edabalans:replace-with-a-long-random-password@postgres:5432/edabalans

# Protected owner-facing CRM. Generate unique production values on the server.
ADMIN_USERNAME=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Tilda sends this value in the X-Tilda-Webhook-Token header.
TILDA_WEBHOOK_TOKEN=replace-with-a-long-random-secret

# Test Telegram bot. Keep real values only in the server .env.
TELEGRAM_TEST_BOT_USERNAME=TetrisgfgfgfBot
TELEGRAM_TEST_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_CHANNEL_ID=@Fitness_Talks

# NocoDB administration. Keep all real values only in the server .env.
NOCODB_ADMIN_EMAIL=replace-with-owner-email@example.com
NOCODB_ADMIN_PASSWORD=replace-with-a-long-random-password
NOCODB_JWT_SECRET=replace-with-a-long-random-secret
NOCODB_CONNECTION_ENCRYPT_KEY=replace-with-a-long-random-secret
